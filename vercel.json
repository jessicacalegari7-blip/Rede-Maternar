{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/editorial-run.mjs": { "maxDuration": 300 },
    "api/professional-research-run.mjs": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/editorial-run", "schedule": "0 21 * * *" },
    { "path": "/api/professional-research-run", "schedule": "30 22 * * *" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/brand/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }] },
    { "source": "/(admin|profissional|paciente)/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/(login|definir-senha|recuperar-senha|convite)/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ],
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "materplace.com.br" }], "destination": "https://www.materplace.com.br/$1", "permanent": true }
  ],
  "rewrites": [
    { "source": "/profissionais/:specialty/:uf/:city/:profile", "has": [{ "type": "header", "key": "user-agent", "value": ".*(Googlebot|bingbot|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot).*" }], "destination": "/api/directory-share?specialty=:specialty&uf=:uf&city=:city&profile=:profile" },
    { "source": "/profissionais/:specialty/:uf/:city", "has": [{ "type": "header", "key": "user-agent", "value": ".*(Googlebot|bingbot|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot).*" }], "destination": "/api/directory-share?specialty=:specialty&uf=:uf&city=:city" },
    { "source": "/noticias/:slug", "has": [{ "type": "header", "key": "user-agent", "value": ".*(Googlebot|bingbot|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|TelegramBot).*" }], "destination": "/api/article-share?slug=:slug" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/sitemap-posts.xml", "destination": "/api/sitemap?type=posts&page=1" },
    { "source": "/sitemap-posts-:page.xml", "destination": "/api/sitemap?type=posts&page=:page" },
    { "source": "/sitemap-diretorio.xml", "destination": "/api/sitemap?type=directory&page=1" },
    { "source": "/sitemap-diretorio-:page.xml", "destination": "/api/sitemap?type=directory&page=:page" },
    { "source": "/sitemap-categorias.xml", "destination": "/api/sitemap?type=categories" },
    { "source": "/sitemap-paginas.xml", "destination": "/api/sitemap?type=pages" },
    { "source": "/sitemap-news.xml", "destination": "/api/sitemap-news" },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
